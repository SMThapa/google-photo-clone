# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files (used for local development)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files (optional - many teams commit this)
# .terraform.lock.hcl

# Ignore plan output files
*.tfplan
plan.out

# OS files
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/
*.swp